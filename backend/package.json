{
  "name": "personal-loan-engine-backend",
  "version": "1.0.0",
  "description": "Rule-based personal loan recommendation engine backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "tsx watch --experimental-sqlite src/server.ts",
    "seed": "tsx --experimental-sqlite src/database/seed.ts",
    "test": "tsx --test --experimental-sqlite tests/**/*.test.ts"
  },
  "keywords": [
    "loan-engine",
    "fintech",
    "recommendation-engine",
    "rule-based"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
